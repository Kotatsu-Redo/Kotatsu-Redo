<?xml version="1.0" encoding="utf-8"?>
<!--
  The reading half scrolls; the writing half does not. Everything to do with composing a comment
  lives on one raised surface pinned to the bottom, so the list above it is nothing but comments and
  the box never has to be hunted for.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<TextView
		android:id="@+id/textView_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="20dp"
		android:layout_marginTop="16dp"
		android:text="@string/community_comments"
		android:textAppearance="?attr/textAppearanceHeadlineSmall"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<!-- Centred on the title, not baselined to it: a small number reads as dropped on a shared baseline. -->
	<TextView
		android:id="@+id/textView_subtitle"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:layout_marginEnd="8dp"
		android:ellipsize="end"
		android:maxLines="1"
		android:textAppearance="?attr/textAppearanceBodyLarge"
		android:textColor="?android:attr/textColorSecondary"
		app:layout_constraintBottom_toBottomOf="@id/textView_title"
		app:layout_constraintEnd_toStartOf="@id/chipGroup_sort"
		app:layout_constraintStart_toEndOf="@id/textView_title"
		app:layout_constraintTop_toTopOf="@id/textView_title"
		tools:text="\u00b7 24" />

	<!--
	  Up on the heading line. On its own row it pushed the list down by a whole chip for two words
	  that are read once and then ignored.
	-->
	<com.google.android.material.chip.ChipGroup
		android:id="@+id/chipGroup_sort"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="20dp"
		app:layout_constraintBottom_toBottomOf="@id/textView_title"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@id/textView_title"
		app:selectionRequired="true"
		app:singleLine="true"
		app:singleSelection="true">

		<!--
		  Top by default: with dislikes as the only moderation signal, the thing that sinks a bad
		  comment has to be the thing that orders the list.
		-->
		<com.google.android.material.chip.Chip
			android:id="@+id/chip_sort_top"
			style="@style/Widget.Material3.Chip.Filter"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:checked="true"
			android:text="@string/community_comments_sort_top" />

		<com.google.android.material.chip.Chip
			android:id="@+id/chip_sort_new"
			style="@style/Widget.Material3.Chip.Filter"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/community_comments_sort_new" />
	</com.google.android.material.chip.ChipGroup>

	<!-- Whichever of the heading and the chips is taller is what the list starts under. -->
	<androidx.constraintlayout.widget.Barrier
		android:id="@+id/barrier_header"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:barrierDirection="bottom"
		app:constraint_referenced_ids="textView_title,chipGroup_sort" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recyclerView"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_marginTop="8dp"
		android:clipToPadding="false"
		android:paddingStart="20dp"
		android:paddingEnd="20dp"
		android:paddingBottom="12dp"
		app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
		app:layout_constraintBottom_toTopOf="@id/card_compose"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/barrier_header"
		tools:itemCount="4"
		tools:listitem="@layout/item_community_comment" />

	<!-- drawableTop rather than a second view: an empty list needs a picture, not a layout. -->
	<TextView
		android:id="@+id/textView_empty"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="32dp"
		android:layout_marginEnd="32dp"
		android:drawablePadding="12dp"
		android:gravity="center"
		android:text="@string/community_comments_empty"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		android:textColor="?android:attr/textColorSecondary"
		android:visibility="gone"
		app:drawableTint="?android:attr/textColorSecondary"
		app:drawableTopCompat="@drawable/ic_comment"
		app:layout_constraintBottom_toBottomOf="@id/recyclerView"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="@id/recyclerView"
		tools:visibility="visible" />

	<com.google.android.material.loadingindicator.LoadingIndicator
		android:id="@+id/progressIndicator"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="@id/recyclerView"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="@id/recyclerView" />

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/card_compose"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
		app:cardCornerRadius="24dp"
		app:cardElevation="0dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:strokeWidth="0dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="12dp"
			android:paddingTop="12dp"
			android:paddingEnd="12dp"
			android:paddingBottom="12dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<!-- Only while replying or editing, so the text always has a visible destination. -->
				<TextView
					android:id="@+id/textView_replying"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="4dp"
					android:layout_weight="1"
					android:ellipsize="end"
					android:maxLines="1"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:textColor="?attr/colorPrimary"
					android:visibility="gone"
					tools:text="Replying to reader#a1b2"
					tools:visibility="visible" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_cancel_compose"
					style="?attr/borderlessButtonStyle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:insetTop="0dp"
					android:insetBottom="0dp"
					android:minWidth="0dp"
					android:text="@android:string/cancel"
					android:visibility="gone"
					tools:visibility="visible" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:baselineAligned="false"
				android:gravity="bottom"
				android:orientation="horizontal">

				<com.google.android.material.textfield.TextInputLayout
					android:id="@+id/textInputLayout_comment"
					style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:hint="@string/community_comment_hint"
					app:boxCornerRadiusBottomEnd="20dp"
					app:boxCornerRadiusBottomStart="20dp"
					app:boxCornerRadiusTopEnd="20dp"
					app:boxCornerRadiusTopStart="20dp">

					<!--
					  No character counter. It sat under the box reading 0/4000 at all times, which is
					  noise for a limit nobody reaches by accident; the field enforces it instead.
					-->
					<com.google.android.material.textfield.TextInputEditText
						android:id="@+id/editText_comment"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:inputType="textMultiLine|textCapSentences"
						android:maxLength="4000"
						android:maxLines="5"
						android:minLines="1" />
				</com.google.android.material.textfield.TextInputLayout>

				<!--
				  The content policy asks people to tag spoilers, so there has to be something to tag
				  them with - and it belongs with the act of sending, not stranded on a row above the
				  box. Checked state is driven in code: an icon button's own checked styling is too
				  quiet to carry a choice this consequential.
				-->
				<com.google.android.material.button.MaterialButton
					android:id="@+id/checkBox_spoiler"
					style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
					android:layout_width="52dp"
					android:layout_height="52dp"
					android:layout_marginStart="6dp"
					android:checkable="true"
					android:contentDescription="@string/community_comment_spoiler"
					android:insetTop="0dp"
					android:insetBottom="0dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:paddingStart="0dp"
					android:paddingEnd="0dp"
					app:icon="@drawable/ic_eye_off"
					app:iconGravity="textStart"
					app:iconPadding="0dp"
					app:iconSize="20dp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_send"
					style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
					android:layout_width="52dp"
					android:layout_height="52dp"
					android:layout_marginStart="6dp"
					android:contentDescription="@string/community_comment_send"
					android:insetTop="0dp"
					android:insetBottom="0dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:paddingStart="0dp"
					android:paddingEnd="0dp"
					app:icon="@drawable/ic_send"
					app:iconGravity="textStart"
					app:iconPadding="0dp"
					app:iconSize="22dp" />
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
