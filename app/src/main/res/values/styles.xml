	<!-- Drawable -->

	<style name="ProgressDrawable">
		<item name="android:fillAlpha">1</item>
		<item name="android:fillColor">?attr/colorPrimary</item>
		<item name="android:strokeColor">?attr/colorSurfaceVariant</item>
		<item name="android:textColor">?attr/colorOnPrimary</item>
		<item name="strokeWidth">4dp</item>
		<item name="android:textSize">9sp</item>
		<item name="autoFitTextSize">true</item>
	</style>

	<!--
		Expressive reading-progress ring.

		The stock style fills a solid primary disc and paints the arc over it in colorSurfaceVariant,
		with no track at all - outlineColor is never set, so the drawable's track branch never runs.
		This one inverts that: a quiet tonal container, a real track drawn as the remainder of the
		circle, and the arc itself in the accent so progress is what carries the colour. The gap
		between arc and track only reads once the track is actually painted.
	-->
	<style name="ProgressDrawable.Expressive">
		<item name="android:fillAlpha">1</item>
		<item name="android:fillColor">?attr/colorSecondaryContainer</item>
		<item name="android:strokeColor">?attr/colorPrimary</item>
		<item name="outlineColor">?attr/colorOutlineVariant</item>
		<item name="android:textColor">?attr/colorOnSecondaryContainer</item>
		<item name="strokeWidth">5dp</item>
		<item name="android:textSize">9sp</item>
		<item name="autoFitTextSize">true</item>
	</style>

	<!--
		Expressive new-chapter badge: a round red counter.

		Zero padding and equal min width/height keep it a true circle - the horizontal padding an
		earlier version had stretched it into an oval as soon as the count reached two digits.

		includeFontPadding matters more here than anywhere else: BadgeView resolves against
		badgeViewStyle rather than android:textViewStyle, so it never picked up the app-wide fix, and
		Google Sans's tall metrics left the number sitting visibly off-centre inside the circle.
	-->
	<style name="Widget.Kotatsu.BadgeView.Expressive">
		<item name="android:textColor">?attr/colorOnError</item>
		<item name="backgroundColor">?attr/colorError</item>
		<item name="shapeAppearance">@style/ShapeAppearanceOverlay.Kotatsu.Circle</item>
		<item name="android:gravity">center</item>
		<item name="android:padding">0dp</item>
		<item name="android:minWidth">@dimen/card_indicator_size_glyph</item>
		<item name="android:minHeight">@dimen/card_indicator_size_glyph</item>
		<item name="android:textSize">11sp</item>
		<item name="android:includeFontPadding">false</item>
		<item name="android:elegantTextHeight">false</item>
		<item name="android:fontFamily">@font/google_sans_bold</item>
		<item name="fontFamily">@font/google_sans_bold</item>
	</style>

	<style name="FaviconDrawable">
		<item name="backgroundColor">?colorBackgroundFloating</item>
		<item name="strokeColor">?colorOutline</item>
	</style>

	<style name="FaviconDrawable.Small">
		<item name="strokeWidth">1dp</item>
		<item name="cornerSize">8dp</item>
	</style>

	<style name="FaviconDrawable.Large">
		<item name="strokeWidth">1dp</item>
		<item name="cornerSize">12dp</item>
	</style>

	<style name="FaviconDrawable.Chip">
