	<!--
		Titles drawn over cover artwork. The shadow lives here rather than on the view because
		DynamicItemSizeResolver re-applies a text appearance whenever the grid size changes, and only
		attributes carried by the appearance itself survive that swap.

		The face is Google Sans, a variable font (GRAD/opsz/wght) rendered at its default instance.
		Both fontFamily attributes are needed: Material's own TitleSmall sets each of them, so leaving
		either one out lets sans-serif-medium win on that code path.
	-->
	<style name="TextAppearance.Kotatsu.GridTitle.OnCover" parent="TextAppearance.Material3.TitleSmall">
		<item name="fontFamily">@font/google_sans_bold</item>
		<item name="android:fontFamily">@font/google_sans_bold</item>
