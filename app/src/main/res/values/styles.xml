	<!-- Widget styles -->

	<!--
		AppCompat lays the query field out as a fixed 36dp box inside a 48dp search bar and leaves it
		on TextView's default TOP gravity, so the query sits high in the field - noticeably above the
		line the clear and overflow icons sit on, with a wide gap down to the underline. Google Sans's
		taller ascent makes it worse than it is with Roboto.

		SearchView exposes no attribute for the inner field, but SearchAutoComplete is constructed with
		autoCompleteTextViewStyle as its default style, so this is the one hook that reaches it. Setting
		it theme-wide covers every inline search in the app rather than the one screen it was reported
		on. The only other AutoCompleteTextViews here are the settings preference dialogs, where the
		field is wrap_content and vertical gravity has nothing to do; TextInputLayout's exposed dropdown
		menus are unaffected, as they set this attribute through their own theme overlay.
	-->
	<style name="Widget.Kotatsu.AutoCompleteTextView" parent="Widget.AppCompat.AutoCompleteTextView">
		<item name="android:gravity">center_vertical|start</item>
	</style>

	<style name="Widget.Kotatsu.SearchView" parent="@style/Widget.AppCompat.SearchView">
		<item name="iconifiedByDefault">false</item>
		<item name="searchIcon">@null</item>
		<item name="queryBackground">@null</item>
		<item name="android:textAppearance">@style/TextAppearance.Kotatsu.SearchView</item>
		<item name="android:textSize">18sp</item>
	</style>

	<!--
		M3 Expressive's "app bar with search" search bar, minus the parts that don't suit a phone-width
		single-pane layout. What is kept is the app-bar search container colour.

		adaptiveMaxWidthEnabled is off because SearchBar.onMeasure clamps the bar to
		max(312dp, 50% of parent) as soon as the parent is wider than 312dp. That is meant for tablets,
		where a full-bleed search bar looks stretched; on a phone it just leaves the bar short with dead
		space either side.

		hideNavigationIcon and defaultMarginsEnabled are restored because MainActivity sets the bar's
		horizontal margins itself from m3_searchbar_margin_horizontal plus the window insets, and the
		bar is the support action bar with its default navigation click listener forced on.
	-->
	<style name="Widget.Kotatsu.SearchBar.AppBarWithSearch" parent="Widget.Material3Expressive.SearchBar.AppBarWithSearch">
		<item name="hideNavigationIcon">false</item>
		<item name="defaultMarginsEnabled">true</item>
		<item name="adaptiveMaxWidthEnabled">false</item>
	</style>

	<!-- Manga grid title, drawn under the cover. Default themes show it, Expressive hides it.
	     Layout params live in item_manga_grid.xml, not here - see the note on that tag. -->
	<style name="Widget.Kotatsu.MangaGridTitle" parent="">
		<item name="android:elegantTextHeight">false</item>
		<item name="android:includeFontPadding">false</item>
		<item name="android:ellipsize">end</item>
		<item name="android:lines">2</item>
		<item name="android:paddingVertical">4dp</item>
		<item name="android:textAppearance">?attr/gridTitleTextAppearance</item>
		<item name="android:textColor">?android:attr/textColorPrimary</item>
		<item name="android:visibility">visible</item>
	</style>

	<style name="Widget.Kotatsu.MangaGridTitle.Hidden">
		<item name="android:visibility">gone</item>
	</style>

	<!-- Manga grid title, drawn over the cover. Hidden unless the theme opts in.
	     maxLines rather than lines: a fixed two-line box reserves height even for a one-line title,
	     which lifts short titles away from the bottom of the cover. -->
	<style name="Widget.Kotatsu.MangaCoverTitle" parent="">
		<item name="android:elegantTextHeight">false</item>
		<!-- Google Sans carries tall ascent/descent metrics, and the default font padding adds more
		     on top. Left on, a two-line title ends up with a band of empty space under it and drifts
		     away from the bottom of the cover. -->
		<item name="android:includeFontPadding">false</item>
		<item name="android:shadowColor">#B3000000</item>
		<item name="android:shadowDx">0</item>
		<item name="android:shadowDy">1</item>
		<item name="android:shadowRadius">3</item>
		<item name="android:ellipsize">end</item>
		<item name="android:maxLines">2</item>
		<item name="android:textAppearance">?attr/gridTitleTextAppearance</item>
		<item name="android:visibility">gone</item>
	</style>

	<style name="Widget.Kotatsu.MangaCoverTitle.Visible">
		<item name="android:visibility">visible</item>
	</style>

