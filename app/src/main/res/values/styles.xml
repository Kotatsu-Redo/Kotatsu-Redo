	<!--
		Google Sans reports tall ascent/descent metrics, and includeFontPadding (on by default) adds a
		further band above and below every line. Across a list of settings rows or a details table that
		compounds into the large gaps between each title and its summary.

		It has to be set on the TextView rather than in the text appearances above: includeFontPadding
		is a TextView attribute and is not part of the TextAppearance styleable, so setTextAppearance
		would ignore it. Applying it through android:textViewStyle catches everything the AppCompat /
		Material inflater creates for a <TextView> tag.
	-->
	<style name="Widget.Kotatsu.TextView" parent="Widget.MaterialComponents.TextView">
		<item name="android:includeFontPadding">false</item>
	</style>

	<!--
		android:textViewStyle only reaches widgets the inflater creates from a <TextView> tag. Anything
		with its own default style attribute - every button, chip and tab - resolves against that
		instead and never sees it, which is what left the split button's label sitting high in its
		pill. These thin subclasses re-apply it on top of the Expressive styles the theme already uses.

		If text turns up off-centre in some other widget, it will be one that resolves its own style
		and is missing from this list.
	-->
	<style name="Widget.Kotatsu.Expressive.Button" parent="Widget.Material3Expressive.Button">
		<item name="android:includeFontPadding">false</item>
	</style>

	<style name="Widget.Kotatsu.Expressive.Button.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
