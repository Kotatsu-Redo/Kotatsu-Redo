<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:title="@string/privacy_and_content">
	<PreferenceCategory android:title="@string/adult_content">

		<SwitchPreferenceCompat
			android:defaultValue="false"
			android:icon="@drawable/ic_sfw"
			android:key="no_nsfw"
			android:summary="@string/disable_nsfw_summary"
			android:title="@string/disable_nsfw" />

		<ListPreference
			android:entries="@array/incognito_nsfw_options"
			android:icon="@drawable/ic_incognito"
			android:key="incognito_nsfw"
			android:title="@string/incognito_for_nsfw"
			app:useSimpleSummaryProvider="true" />

		<SwitchPreferenceCompat
			android:defaultValue="true"
			android:icon="@drawable/ic_shortcut"
			android:key="shortcuts_no_nsfw"
			android:summary="@string/exclude_nsfw_from_shortcuts_summary"
			android:title="@string/exclude_nsfw_from_shortcuts" />

		<SwitchPreferenceCompat
			android:defaultValue="false"
			android:icon="@drawable/ic_notification"
			android:key="tracker_no_nsfw"
			android:summary="@string/disable_nsfw_notifications_summary"
			android:title="@string/disable_nsfw_notifications" />

		<SwitchPreferenceCompat
			android:defaultValue="false"
			android:icon="@drawable/ic_suggestion"
			android:key="suggestions_exclude_nsfw"
			android:summary="@string/exclude_nsfw_from_suggestions_summary"
			android:title="@string/exclude_nsfw_from_suggestions" />

		<SwitchPreferenceCompat
			android:icon="@drawable/ic_discord"
			android:key="discord_rpc_skip_nsfw"
			android:summary="@string/rpc_skip_nsfw_summary"
			android:title="@string/hide_nsfw_from_discord" />

	</PreferenceCategory>

	<PreferenceCategory android:title="@string/app_security">

		<SwitchPreferenceCompat
			android:icon="@drawable/ic_lock"
			android:key="protect_app"
			android:persistent="false"
			android:summary="@string/protect_application_summary"
			android:title="@string/protect_application" />

		<ListPreference
			android:defaultValue="allow"
			android:entries="@array/screenshots_policy"
			android:icon="@drawable/ic_data_privacy"
			android:key="screenshots_policy"
			android:title="@string/screenshots_policy"
			app:useSimpleSummaryProvider="true" />

	</PreferenceCategory>

	<PreferenceCategory android:title="@string/your_activity">

		<org.koitharu.kotatsu.settings.utils.SplitSwitchPreference
			android:defaultValue="false"
			android:icon="@drawable/ic_chart"
			android:key="stats_on"
			android:title="@string/reading_stats" />

		<!-- Kept in the community settings' own file, so this one is read and written by hand. Separate from
		     the community switch on purpose: it carries a pseudonym that rotates daily and no manga titles,
		     so someone may reasonably want one without the other. -->
		<SwitchPreferenceCompat
			android:icon="@drawable/ic_trending_small"
			android:key="telemetry"
			android:persistent="false"
			android:summary="@string/community_telemetry_summary"
			android:title="@string/community_telemetry" />

	</PreferenceCategory>

</PreferenceScreen>
